def compute_band_powers(signal, fs):
    # Вычисляем FFT
    freqs = np.fft.rfftfreq(len(signal), d=1/fs)
    fft_values = np.abs(np.fft.rfft(signal))**2

    # Определяем мощность в каждом диапазоне
    def band_power(freqs, fft_values, low, high):
        band = np.logical_and(freqs >= low, freqs <= high)
        return np.sum(fft_values[band])

    delta = band_power(freqs, fft_values, 0.5, 4)
    theta = band_power(freqs, fft_values, 4, 8)
    alpha = band_power(freqs, fft_values, 8, 13)
    beta = band_power(freqs, fft_values, 13, 30)
    gamma = band_power(freqs, fft_values, 30, 50)

    return {"Delta": delta, "Theta": theta, "Alpha": alpha, "Beta": beta, "Gamma": gamma}

def analyze_eeg_bands(file_path, dataset_name):
    with h5py.File(file_path, 'r') as file:
        dataset = file[dataset_name]
        eeg1 = dataset['eeg1_name']
        eeg2 = dataset['eeg2_name']
        eeg3 = dataset['eeg3_name']
        eeg4 = dataset['eeg4_name']

        fs = 250  # Частота дискретизации

        # Рассчитываем мощность диапазонов для первых 1000 отсчетов каждого канала
        bands_eeg1 = compute_band_powers(eeg1[:1000], fs)
        bands_eeg2 = compute_band_powers(eeg2[:1000], fs)
        bands_eeg3 = compute_band_powers(eeg3[:1000], fs)
        bands_eeg4 = compute_band_powers(eeg4[:1000], fs)

        # Выводим результаты
        print("Мощности частотных диапазонов (EEG1):", bands_eeg1)
        print("Мощности частотных диапазонов (EEG2):", bands_eeg2)
        print("Мощности частотных диапазонов (EEG3):", bands_eeg3)
        print("Мощности частотных диапазонов (EEG4):", bands_eeg4)

