# Конфигурация ленты
LED_COUNT = 30      # Количество светодиодов
LED_PIN = 18        # GPIO-пин (может отличаться в зависимости от вашей конфигурации)
LED_FREQ_HZ = 800000  # Частота (Гц)
LED_DMA = 10         # DMA-канал
LED_BRIGHTNESS = 255  # Яркость (0-255)
LED_INVERT = False    # Инверсия сигнала
LED_CHANNEL = 0       # Канал

# Инициализация ленты
strip = PixelStrip(LED_COUNT, LED_PIN, LED_FREQ_HZ, LED_DMA, LED_INVERT, LED_BRIGHTNESS, LED_CHANNEL)
strip.begin()

def set_strip_color(strip, color):
    """Устанавливает цвет всей ленты."""
    for i in range(strip.numPixels()):
        strip.setPixelColor(i, color)
    strip.show()

def map_bands_to_color(bands):
    """Привязывает диапазоны частот к цветам."""
    max_band = max(bands, key=bands.get)  # Находим доминирующий диапазон
    if max_band == "Delta":
        return Color(0, 0, 255)  # Синий
    elif max_band == "Theta":
        return Color(0, 255, 255)  # Голубой
    elif max_band == "Alpha":
        return Color(0, 255, 0)  # Зеленый
    elif max_band == "Beta":
        return Color(255, 255, 0)  # Желтый
    elif max_band == "Gamma":
        return Color(255, 0, 0)  # Красный
    return Color(255, 255, 255)  # Белый (по умолчанию)

def control_led_strip(file_path, dataset_name):
    """Читает данные, анализирует диапазоны и меняет цвет ленты."""
    with h5py.File(file_path, 'r') as file:
        dataset = file[dataset_name]
        eeg1 = dataset['eeg1_name']

        fs = 250  # Частота дискретизации
        bands = compute_band_powers(eeg1[:1000], fs)  # Анализ диапазонов
        print("Мощности частотных диапазонов:", bands)

        # Определяем цвет и устанавливаем его
        color = map_bands_to_color(bands)
        set_strip_color(strip, color)

# Пример вызова
control_led_strip(file_path, dataset_name)
